# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Editors
.vscode/
.idea/

# Large run artifacts — decisions.jsonl files can be hundreds of GB.
# Commit only metrics.json and summary.md; keep raw decision logs local.
data/runs/**/*.jsonl
data/runs/**/*.jsonl.gz

# CFR distillation shards and precomputed trunk activations are huge
# (single 50k cell ~20 GB) and reproducible from the seed + config.
# Keep run metadata (config.yaml, manifest.json, *_summary.json,
# training_curve.json, checkpoints) but exclude raw shards.
data/runs/**/cfr_deals/
data/runs/**/*.npz

# Sweep + pilot stdout logs — large, reproducible, contain progress noise.
data/runs/*.log

# W&B local run cache (synced to wandb.ai, not needed in git)
src/wandb/
wandb/
